APP_NAME=Omaglee
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ServerByt MySQL / MariaDB Database Configuration
DB_CONNECTION=mysql
DB_HOST=shareddb-g.hosting.stackcp.net
DB_PORT=3306
DB_DATABASE=Omaglee-3731af1f
DB_USERNAME=Omaglee
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Laravel Reverb Realtime Signaling Configuration
REVERB_APP_ID=omaglee-app-id
REVERB_APP_KEY=omaglee-app-key
REVERB_APP_SECRET=omaglee-app-secret
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME=http

CACHE_STORE=file
CACHE_PREFIX=

# WebRTC STUN & TURN Relay Configuration (Phase 6)
WEBRTC_STUN_URLS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
TURN_ENABLED=false
TURN_HOST=turn.example.com
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_SECRET=
TURN_TLS_ENABLED=false
TURN_CREDENTIAL_TTL=600

# Redis & Retention Configuration (Phase 8)
REDIS_ENABLED=false
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1

ANONYMOUS_SESSION_TTL=7200
MATCH_HISTORY_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=90

# Frontend URLs for CORS Allowlist
FRONTEND_WEB_URL=http://localhost:5173
FRONTEND_ADMIN_URL=http://localhost:5174
